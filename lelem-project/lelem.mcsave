dence":"inspection","evidenceRef":"","attachments":[],"signedBy":"","signedDate":"","note":"","since":"2023-03-31"},{"n":3,"title":"Continuous ventilation established","party":"Entry Supervisor","partyPersonId":"","required":true,"evidence":"inspection","evidenceRef":"","attachments":[],"signedBy":"","signedDate":"","note":"","since":"2023-03-31"},{"n":4,"title":"Attendant named and briefed","party":"Entry Supervisor","partyPersonId":"","required":true,"evidence":"none","evidenceRef":"","attachments":[],"signedBy":"","signedDate":"","note":"","since":"2023-03-31"},{"n":5,"title":"Rescue plan and retrieval equipment on site","party":"Safety Manager","partyPersonId":"","required":true,"evidence":"document","evidenceRef":"","attachments":[],"signedBy":"","signedDate":"","note":"","since":"2023-03-31"},{"n":6,"title":"Entry log opened","party":"Attendant","partyPersonId":"","required":true,"evidence":"none","evidenceRef":"","attachments":[],"signedBy":"","signedDate":"","note":"","since":"2023-03-31"}],"createdAt":"2026-09-05T21:14:24.621Z","createdBy":"admin"}],"updated":"2026-09-08T00:37:43.925Z"},"reportNarrative":{"data":{"exec":"Data date 31 March 2023. The structure is topped out, the building is dried in and interior fit-out is under way on both levels. The forecast substantial completion has moved against the contract baseline on the glulam delivery and the curtain wall resubmittal; a recovery plan for the Level 1 finishes is in place with Delta Drywall and Cascade Painting.","schedule":"Critical path runs through drywall and ceilings on Level 1 into the gym floor and the fire alarm verification. Delay events DE-001 to DE-008 are logged in the forensics register; the weather allowance for November to February was consumed in full.","cost":"Committed cost sits within the prime contract with the approved change orders. Direct costs are 30 percent of cost to date; pending change events are netted against the change orders raised from them.","quality":"Forty non-conformances raised to date, the majority closed after rework. Footing and slab pre-pour inspections passed on first presentation except F5, which was re-surveyed.","safety":"Twelve recordable or first-aid events and weekly toolbox talks on every crew. No lost-time incident since December; the winter-conditions and crane-signals talks were repeated in January.","variances":{}},"updated":"2026-09-08T00:37:43.925Z"},"reportPackets":{"data":[{"id":1,"name":"Monthly owner report","sections":["exec","schedule","budget","delivery","dailylog","safety"],"format":"both","createdAt":"2026-09-05T21:14:30.557Z","updatedAt":"2026-09-05T21:14:30.557Z","lastRunAt":"2026-09-05T21:14:33.432Z","runs":1},{"id":2,"name":"Weekly site report","sections":["schedule","delivery","dailylog","safety"],"format":"both","createdAt":"2026-09-05T21:14:31.745Z","updatedAt":"2026-09-05T21:14:31.745Z","lastRunAt":null,"runs":0}],"updated":"2026-09-08T00:37:43.925Z"},"notifications":{"data":{"acked":{"u_5c5efc8baaec2f26":{"high|RFIs overdue|rfi-overdue|122bc4e":1,"warn|Critical starting|447|nb4z7g":1,"warn|Critical starting|448|emsgx4":1,"warn|Punch items overdue|punch-overdue|1ynuwj8":1,"warn|Change orders pending|co-pending|12bsewm":1,"info|Milestone approaching|450|1gfhe8o":1}},"seen":{"u_5c5efc8baaec2f26":{"high|RFIs overdue|rfi-overdue|122bc4e":1,"warn|Punch items overdue|punch-overdue|1ynuwj8":1,"warn|Change orders pending|co-pending|12bsewm":1,"warn|Critical starting|447|nb4z7g":1,"warn|Critical starting|448|emsgx4":1,"info|In progress|443|16b7r9w":1,"info|Milestone approaching|450|1gfhe8o":1}}},"updated":"2026-09-08T00:37:43.925Z"},"notificationMutes":{"data":{"u_5c5efc8baaec2f26":{"In progress":1}},"updated":"2026-09-08T00:37:43.925Z"},"earlyWarnings":{"data":[],"updated":"2026-09-08T00:37:43.925Z"},"earlyWarningWeights":{"data":{"spi":22,"cpi":16,"riskSlip":16,"critical":14,"rfi":8,"safety":12,"quality":8,"weather":14},"updated":"2026-09-08T00:37:43.925Z"},"customFields":{"data":[{"id":"CF-001"